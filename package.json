{
  "name": "dune-prime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out --listen tcp://0.0.0.0:${PORT:-3000} --no-port-switching",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "predev": "npm run images",
    "prebuild": "npm run images"
  },
  "dependencies": {
    "next": "16.4.6",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serve": "^14.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "railway": "^3.17.0",
    "sharp": "^0.35.5",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
