# Inquiry API settings. Copy to .env for local use (`node --env-file=.env dist/server.js`),
# and set the same values in Railway → (api service) → Variables.
# Every integration is optional: without its values the API logs instead of sending.

NODE_ENV=production
# Railway sets PORT automatically.
# PORT=4000

# Website origins allowed to call the API (comma-separated). Default: both dunepr.com hosts.
ALLOWED_ORIGINS=https://www.dunepr.com,https://dunepr.com

# --- Google Sheet (where inquiries are stored) ---
# 1. Google Cloud: create a service account, enable "Google Sheets API", create a JSON key.
# 2. Share the sheet with the service account email as Editor.
# 3. The sheet ID is the long part of the sheet URL between /d/ and /edit.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Inquiries
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the "private_key" value from the JSON key (\n escapes are fine).
GOOGLE_PRIVATE_KEY=

# --- Email (auto-reply to the visitor + team alerts) ---
# Sender address; its domain must be verified with the provider (SPF/DKIM).
MAIL_FROM=Dune Prime <hello@dunepr.com>
# Where visitor replies go when the inquiry has no owner email.
MAIL_REPLY_TO=
# Option A (recommended on Railway): Resend API key from resend.com.
RESEND_API_KEY=
# Option B: SMTP (e.g. Google Workspace). Railway may block outbound SMTP on some plans.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Team alerts ---
# Always alerted (comma-separated).
TEAM_ALERT_EMAILS=
TEAM_ALERT_WHATSAPP=
# Owner per inquiry type (handoff: "each type has an owner"). JSON; keys: investor, owner,
# broker, financial_partner, other, default. Example:
# INQUIRY_OWNERS={"investor":{"name":"Investor desk","email":"invest@dunepr.com","whatsapp":"+971500000000"},"default":{"name":"Front desk","email":"hello@dunepr.com"}}
INQUIRY_OWNERS={}

# --- WhatsApp Cloud API (Meta) ---
# Needs a WhatsApp Business account and an approved message template whose body has
# 5 placeholders: {{1}} headline, {{2}} name, {{3}} email, {{4}} type, {{5}} owner.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=new_inquiry
WHATSAPP_TEMPLATE_LANG=en
# Graph API version; check Meta's docs for the current one.
WHATSAPP_API_VERSION=v21.0

# --- Cloudflare Turnstile (anti-spam) ---
# Secret key here; the matching site key goes in the website's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# Set both or neither.
TURNSTILE_SECRET_KEY=

# --- Limits and reminders ---
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=10
REMINDER_AFTER_HOURS=24
