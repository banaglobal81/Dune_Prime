# Copy to .env.local for local development, and set the same values in
# Cloudflare Pages → Settings → Environment variables for production.

# Public origin of the site, without a trailing slash. Used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://duneprime.com

# Inquiry endpoint (Cloudflare Worker) that receives a JSON POST. Leave empty for demo mode (nothing is sent).
NEXT_PUBLIC_FORM_ENDPOINT=
