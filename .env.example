# Copy to .env.local for local development, and set the same values in
# Railway → Variables for production (before the build).

# Public origin of the site, without a trailing slash. Used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.dunepr.com

# Inquiry API (the api/ service, e.g. https://api.dunepr.com/inquiries) that receives a JSON POST. Leave empty for demo mode (nothing is sent).
NEXT_PUBLIC_FORM_ENDPOINT=

# Cloudflare Turnstile site key (public). Leave empty to hide the anti-spam widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
